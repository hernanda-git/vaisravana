# Vaiśravaṇa — environment template (copy to .env on the VPS; all optional).
# Copy this file to `.env` and fill in. The bot reads it via a tiny inline loader
# (no python-dotenv dependency). Every value has a safe default, so an empty .env
# is fine for a fresh start.

# ── Telegram (required for notifications + /commands) ──
TELEGRAM_BOT_TOKEN=botXXXX:YYYY
NOTIFY_CHAT_ID=5894116684

# ── Data locations (portable defaults: ./data next to the repo) ──
# On Fly these point at the /data volume; leave unset on a bare VPS.
# VAISRAVANA_DB=/data/vaisravana.db
# VAISRAVANA_SURFACE=/data/surface.json
# VAISRAVANA_EXCLUSIONS=/data/exclusions.json
# VAISRAVANA_DATA_DIR=/data

# ── Binance klines (geo-blocked in some regions, e.g. mainland CN) ──
# Override with a proxy/mirror if fapi.binance.com is unreachable:
# VAISRAVANA_KLINES_URL=https://your-proxy.example.com/fapi/v1/klines?symbol={s}&interval={t}&limit={n}
# Or set an HTTP(S) proxy and the bot installs a proxy opener at import time:
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# ── Trading universe / cadence ──
# VAISRAVANA_PAIRS=BTCUSDT,ETHUSDT,SOLUSDT
# VAISRAVANA_TFS=5m,15m
# VAISRAVANA_CYCLE_S=60

# ── Mode (PAPER is the only safe default; LIVE requires human approval) ──
# VAISRAVANA_MODE=paper

# ── LLM research (optional; the OpenCode Zen gateway is local-only — set your own) ──
# ZEN_API_KEY=sk-...
# ZEN_URL=https://your-openai-compatible-endpoint/v1/chat/completions
# ZEN_MODEL=deepseek-v4-flash
